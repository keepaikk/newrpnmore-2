# RPNMore Production Environment Variables
# Copy this to .env and fill in real values for local dev.
# In Dokploy, set these via the Environment Variables UI.

NODE_ENV=production
PORT=3000

# Database
DATABASE_URL=postgresql://rpnmore:rpnmore_secret@db:5432/rpnmore_db?schema=public

# Session (generate with: openssl rand -base64 48)
SESSION_SECRET=change-this-to-a-randomly-generated-secret-key-min-32-chars

# Admin Auth (generate hash with: cd backend && node scripts/hash-password.js <password>)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Telegram Bot (get token from @BotFather)
TELEGRAM_BOT_TOKEN=

# Production domain (no trailing slash)
APP_URL=https://your-domain.com

# Webhook secret (random string)
TELEGRAM_WEBHOOK_SECRET=rpnmore_webhook_secret_2026

# Cookie security
SECURE_COOKIES=true
