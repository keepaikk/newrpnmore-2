# Development environment variables
# Copy this file to .env and fill in the values

# PostgreSQL database connection
DATABASE_URL="postgresql://rpnmore:rpnmore_secret@localhost:5432/rpnmore_db?schema=public"

# Session secret for admin authentication
SESSION_SECRET="change-this-to-a-randomly-generated-secret-key"

# Admin credentials
ADMIN_USERNAME="admin"
# Generate a hash with: cd backend && node scripts/hash-password.js your-password
ADMIN_PASSWORD_HASH=""

# Backend port
PORT=3000
